# Database. Not currently used — plan data is fetched live from the
# Oz Broadband Review API (see lib/external/ozbroadbandReview.ts).
# Reserved for a future real database if/when needed.
DATABASE_URL=

# Optional: enables live AI recommendations via OpenAI. Without this,
# the AI recommendation service falls back to a deterministic mock
# response built from structured comparison data.
OPENAI_API_KEY=

# Public site URL, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://compare.comfilux.com.au

# Optional: enables higher-quality provider logos via logo.dev (free
# tier, no credit card — sign up at https://www.logo.dev/). Without
# this, provider logos fall back to Google's public favicon service
# for providers we have a verified domain for, and to a plain initials
# avatar for everyone else. This is a public/embeddable key, safe to
# expose client-side.
NEXT_PUBLIC_LOGO_DEV_KEY=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Analytics is disabled entirely if this is not set.
NEXT_PUBLIC_GA_ID=
